# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=claim2car_db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# Mock Service Configuration (for demo)
MOCK_MODE=true

# Twilio Mock
TWILIO_ACCOUNT_SID=mock_twilio_sid
TWILIO_AUTH_TOKEN=mock_twilio_token
TWILIO_PHONE_NUMBER=+15555551234

# Stripe Mock
STRIPE_API_KEY=mock_stripe_key
STRIPE_WEBHOOK_SECRET=mock_webhook_secret

# AWS S3 Mock
AWS_ACCESS_KEY_ID=mock_aws_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret
AWS_BUCKET_NAME=claim2car-uploads
AWS_REGION=us-east-1
